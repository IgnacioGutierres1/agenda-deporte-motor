# Agenda Deporte Motor — variables de entorno del pipeline.
# Copiar a .env (no se versiona) o cargarlas como secretos de GitHub Actions.

# ── Gemini (flujo genérico: calendarios sin lector propio, cronogramas, resultados y campeonatos) ──
# Sin clave, las categorías que necesitan IA quedan "a confirmar" o con error "Falta GEMINI_API_KEY";
# las que se leen en forma directa siguen funcionando.
GEMINI_API_KEY=

# Proveedor: aistudio (por defecto, usa GEMINI_API_KEY) | vertex (Vertex AI; el crédito mensual de
# Google AI Pro a veces solo se aplica por Vertex).
GEMINI_PROVIDER=aistudio

# Solo con GEMINI_PROVIDER=vertex:
GOOGLE_CLOUD_PROJECT=
# "global" o una región, p. ej. us-central1
GOOGLE_CLOUD_LOCATION=global
# Token OAuth de corta duración, p. ej. `gcloud auth print-access-token` o el paso google-github-actions/auth.
GOOGLE_ACCESS_TOKEN=

# Modelo para transcribir documentos (plan gratuito). Alternativa más barata/rápida: gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.6-flash
# Modelos de respaldo cuando el principal agota su cupo diario (cada uno tiene el suyo), separados por coma.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# Modelo para la búsqueda con Google del descubrimiento (Fuente 2). En 2.5 Flash/Flash-Lite la búsqueda
# es gratuita (500/día); en Gemini 3+ es paga. gemini-2.5-flash se retira el 1/12/2026.
GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite

# Tope de pedidos de IA por corrida, para toda la cadena (cuida el cupo gratuito), y pausa entre llamadas a Gemini (ms).
GEMINI_MAX_CALLS=60
GEMINI_DELAY_MS=4000
# Reintentos ante 429/5xx (espera 5 s, 15 s, 45 s… o la que indique la API).
GEMINI_RETRIES=3

# ── Respaldo gratuito: Groq ──
# Cadena de IA: Gemini primero; cuando agota el cupo diario de todos sus modelos (o falta la clave, o falla),
# los pedidos pasan a Groq (plan gratis, sin tarjeta). Sin clave, Groq se omite y se usa solo Gemini.
# Clave: https://console.groq.com/keys
GROQ_API_KEY=
# Modelo de texto (JSON estricto) y respaldos, separados por coma ("none" = sin respaldos). Cada uno tiene su cupo.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
# Modelo con visión para calendarios/cronogramas publicados como imagen ("none" = no mandar imágenes a Groq).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Imágenes por pedido (cada una ocupa ~2 mil tokens del cupo por minuto).
GROQ_VISION_MAX_IMAGES=2
# El plan gratis permite ~8 mil tokens por minuto: tope estimado de entrada por pedido (los documentos más largos
# se recortan a las partes que nombran la serie/evento) y de salida.
GROQ_MAX_INPUT_TOKENS=5000
GROQ_MAX_OUTPUT_TOKENS=3000
# Pausa entre pedidos (ms), reintentos ante límites por minuto y espera total máxima por corrida (s).
GROQ_DELAY_MS=2500
GROQ_RETRIES=3
GROQ_MAX_WAIT_S=480

# ── Descubrimiento ──
# 1 = activa la Fuente 2 (Gemini con búsqueda de Google) aunque config/discovery.json diga searchEnabled=false.
DISCOVERY_SEARCH=0

# ── Rutas (opcional) ──
# DM_CONFIG_DIR=config
# DM_DATA_DIR=data
