# Ruta base donde se publica la app (GitHub Pages: /<repo>/). Se lee en vite.config.ts.
VITE_BASE=/agenda-deporte-motor/
# Repositorio por defecto para "Forzar actualización" y la edición de categorías (owner/repo).
VITE_GITHUB_REPO=owner/agenda-deporte-motor
# Client ID OAuth (tipo "Aplicación web") para cargar en Google Calendar. También se puede cargar en Ajustes.
VITE_GOOGLE_CLIENT_ID=
