    {
      "id": "braun-colin",
      "wikidata": "Q1108361",
      "summary": {
        "text": "Colin James Braun ( \"brown\"; born September 22, 1988) is an American racing driver. He is the 2014 and 2015 WeatherTech SportsCar Championship Prototype Challenge Champion and currently drives the No. 60 Meyer Shank Racing Acura ARX-06 for Meyer Shank Racing in the IMSA WeatherTech SportsCar Championship. Driving the ARX-06, he was part of the winning team of the 2023 24 Hours of Daytona. He formerly competed in the NASCAR Craftsman Truck Series and the Xfinity Series. He lives in Charlotte, North Carolina.",
        "lang": "en",
        "url": "https://en.wikipedia.org/wiki/Colin_Braun"
      },
      "birthDate": "1988-09-22",
      "birthPlace": "Ovalo, Estados Unidos",
