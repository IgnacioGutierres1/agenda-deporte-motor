    {
      "id": "ankrum-tyler",
      "wikidata": "Q55955759",
      "summary": {
        "text": "Tyler Michael Ankrum (born March 6, 2001) is an American professional stock car racing driver. He last competed full-time in the NASCAR Craftsman Truck Series, driving the No. 18 Chevrolet Silverado RST for McAnally–Hilgemann Racing, and part-time in the NASCAR O'Reilly Auto Parts Series, driving the No. 32 Chevrolet Camaro SS for Jordan Anderson Racing. Ankrum won the 2018 NASCAR K&N Pro Series East championship, earning DGR-Crosley's first championship in any racing series. Ankrum is the first driver born in the 21st century or later to win a NASCAR national series race.",
        "lang": "en",
        "url": "https://en.wikipedia.org/wiki/Tyler_Ankrum"
      },
      "birthDate": "2001-03-06",
      "birthPlace": "San Bernardino, Estados Unidos",
      "nationality": "Estados Unidos",
      "photo": {
        "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/Tyler_ankrum_%2849562471447%29.jpg/500px-Tyler_ankrum_%2849562471447%29.jpg",
