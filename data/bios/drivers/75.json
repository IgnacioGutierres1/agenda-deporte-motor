    {
      "id": "elfyn-evans",
      "wikidata": "Q5359948",
      "summary": {
        "text": "Elfyn Rhys Evans (Dinas Mawddwy, Gales, 28 de diciembre de 1988) es un piloto de rally británico. Compite en el Campeonato Mundial de Rally (WRC) desde 2014, cuando fue contratado por M-Sport WRT. Con este equipo ganó su primer rally, el Rally de Gran Bretaña de 2017. Desde 2020, compite con el Toyota Gazoo Racing WRT, con el cual se coronó campeón en la temporada 2026, y subcampeón en 2020, 2021, 2023, 2024 y 2025.",
        "lang": "es",
        "url": "https://es.wikipedia.org/wiki/Elfyn_Evans"
      },
      "birthDate": "1988-12-28",
      "nationality": "Gales",
      "photo": {
        "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/9/99/WRC_Central_European_Rallye_2023_Elfyn_Evans_%28cropped%29.jpg/500px-WRC_Central_European_Rallye_2023_Elfyn_Evans_%28cropped%29.jpg",
        "width": 480,
        "height": 640,
        "credit": "Lukas Raich",
        "license": "CC BY-SA 4.0",
        "page": "https://commons.wikimedia.org/wiki/File:WRC_Central_European_Rallye_2023_Elfyn_Evans_(cropped).jpg"
      },
