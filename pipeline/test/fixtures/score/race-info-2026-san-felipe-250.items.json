{"page":5,"x":50.4,"y":407.2,"w":166.9,"s":"CHECKPOINT CLOSING TIMES"},
{"page":5,"x":220.7,"y":407.2,"w":5,"s":"–"},
{"page":5,"x":228.8,"y":407.2,"w":176.8,"s":"All 4-WV and Moto/Quad Classes"},
{"page":5,"x":408.4,"y":407.2,"w":133.8,"s":"- You MUST ARRIVE at each"},
{"page":5,"x":50.4,"y":394,"w":507.6,"s":"checkpoint before closing time. If you are late AT ANY CHECKPOINT, you may be stopped and your race is"},
{"page":5,"x":50.4,"y":381,"w":447,"s":"over! Failure to stop as directed by SCORE official will result in disqualification and no points."},
{"page":5,"x":50.4,"y":362,"w":229,"s":"STAFFED CHECKPOINTS AND PENALTIES"},
{"page":5,"x":50.4,"y":345.9,"w":187.4,"s":"The penalty for missing a checkpoint is"},
{"page":5,"x":240.8,"y":345.9,"w":65.4,"s":"one (1) hour"},
{"page":5,"x":309.2,"y":345.9,"w":228.8,"s":"for each checkpoint missed. You are required to"},
{"page":5,"x":50.4,"y":333,"w":224.5,"s":"enter the coned area at Manned Checkpoints at"},
{"page":5,"x":278,"y":333,"w":39.8,"s":"15 mph"},
{"page":5,"x":320.5,"y":333,"w":220,"s":"in a single file manner and follow directions of"},
{"page":5,"x":50.4,"y":320,"w":106.2,"s":"checkpoint personnel."},
{"page":5,"x":159.7,"y":320,"w":235.5,"s":"You must be prepared to stop if signaled to do so"},
{"page":5,"x":395.2,"y":320,"w":137.9,"s":". Failure to follow checkpoint"},
{"page":5,"x":50.4,"y":307.1,"w":267.9,"s":"personnel directions may result in an additional penalty."},
{"page":5,"x":50.4,"y":288.1,"w":125.7,"s":"The checkpoint corridor is"},
{"page":5,"x":179.1,"y":288.1,"w":26.2,"s":"NOT"},
{"page":5,"x":208.2,"y":288.1,"w":313.3,"s":"considered part of the racecourse. Checkpoint speed zone begins"},
{"page":5,"x":524.4,"y":288.1,"w":19.7,"s":"150"},
{"page":5,"x":50.4,"y":275.1,"w":21.8,"s":"feet"},
{"page":5,"x":74.9,"y":275.1,"w":133.1,"s":"before checkpoint and ends"},
{"page":5,"x":210.6,"y":275.1,"w":45,"s":"100 feet"},
{"page":5,"x":258.6,"y":275.1,"w":279.3,"s":"after checkpoint. Entering and exiting all checkpoint zones"},
{"page":5,"x":50.4,"y":261.9,"w":484.9,"s":"must be done in a safe and prudent manner in order to guarantee the safety of all checkpoint workers."},
{"page":5,"x":50.4,"y":243,"w":505.5,"s":"Passing is not permitted in checkpoint speed zones. Pitting is not permitted within 300 feet before and 100"},
{"page":5,"x":50.4,"y":230,"w":109.1,"s":"feet after a checkpoint."},
{"page":5,"x":162.3,"y":230,"w":336.5,"s":"Penalty for speeding in a checkpoint zone is a minimum of 15 minutes!"},
{"page":5,"x":50.4,"y":211,"w":503.6,"s":"If you are signaled to STOP at a checkpoint and it is determined the unit failed to transmit tracking data as"},
{"page":5,"x":50.4,"y":198.1,"w":506.7,"s":"a result of physical damage or tampering, and you failed to stop on your own, a 15-minute penalty for each"},
{"page":5,"x":50.4,"y":185.1,"w":303.6,"s":"checkpoint you have passed without stopping will be assessed."},
{"page":5,"x":50.4,"y":165.9,"w":495.1,"s":"If you do not stop when signaled to do so, you will be assessed a 15-minute penalty for each checkpoint"},
{"page":5,"x":50.4,"y":152.9,"w":320.6,"s":"where you fail to STOP and no time credit will be given for the stop."},
{"page":5,"x":55,"y":131.5,"w":14.9,"s":"➔"},
{"page":5,"x":73.5,"y":131.5,"w":455.4,"s":"Missing a physical checkpoint is a one (1) hour penalty for each checkpoint missed"}
]
